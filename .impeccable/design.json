  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main voice, listening or next-step action.",
      "html": "<button type=\"button\" class=\"ds-primary\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 19v3\"/><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"/><rect x=\"9\" y=\"2\" width=\"6\" height=\"13\" rx=\"3\"/></svg>Start a conversation<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:43px;border:0;border-radius:8px;padding:12px 17px;font-family:var(--font-body,\"Hanken Grotesk\",sans-serif);font-size:13px;font-weight:600;line-height:1.2;cursor:pointer;transition:background .15s,color .15s;background:var(--purple,#6350c6);color:var(--white,#fff);}.ds-primary:hover{background:var(--purple-dark,#5140a8);}.ds-primary:focus-visible{outline:3px solid #9382df;outline-offset:4px;}.ds-primary:disabled{opacity:.46;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary listening, text or practice action.",
      "html": "<button type=\"button\" class=\"ds-outline\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"/><path d=\"M16 9a5 5 0 0 1 0 6\"/><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"/></svg>Hear it</button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:43px;border:0;border-radius:8px;padding:12px 17px;font-family:var(--font-body,\"Hanken Grotesk\",sans-serif);font-size:13px;font-weight:600;line-height:1.2;cursor:pointer;transition:background .15s,color .15s;border:1px solid #d6d2df;background:transparent;color:#50486b;}.ds-outline:hover{background:#f2edf9;}.ds-outline:focus-visible{outline:3px solid #9382df;outline-offset:4px;}.ds-outline:disabled{opacity:.46;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-outline{transition:none;}}"
    },
    {
      "name": "Small Button",
      "kind": "button",
      "refersTo": "button-small",
      "description": "Compact lavender action within a conversation heading.",
      "html": "<button type=\"button\" class=\"ds-small\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 19v3\"/><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"/><rect x=\"9\" y=\"2\" width=\"6\" height=\"13\" rx=\"3\"/></svg>Switch to voice</button>",
      "css": ".ds-small{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:43px;border:0;border-radius:8px;padding:12px 17px;font-family:var(--font-body,\"Hanken Grotesk\",sans-serif);font-size:13px;font-weight:600;line-height:1.2;cursor:pointer;transition:background .15s,color .15s;font-size:11px;padding:10px 12px;min-height:36px;background:var(--lavender,#eee8fa);color:var(--purple-dark,#5140a8);}.ds-small:focus-visible{outline:3px solid #9382df;outline-offset:4px;}.ds-small:disabled{opacity:.46;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-small{transition:none;}}"
    },
    {
